---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <main class="page notfound">
    <p class="hand">jejda…</p>
    <h1>Tahle stránka ještě není nakreslená.</h1>
    <p><a href="/">← zpátky na úvod</a></p>
  </main>
</Base>

<style>
  .notfound {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.5rem;
  }
  .hand {
    font-size: 2.5rem;
    color: var(--tomato);
  }
  h1 {
    font-size: clamp(2.75rem, 9vw, 6rem);
    font-weight: 800;
  }
</style>
