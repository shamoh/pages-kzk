---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <main class="page notfound">
    <p class="label">404</p>
    <h1>Tahle stránka ještě není nakreslená.</h1>
    <p><a href="/">← zpátky na úvod</a></p>
  </main>
</Base>

<style>
  .notfound {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.5rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-style: italic;
    max-width: 16ch;
  }
</style>
