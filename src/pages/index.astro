---
import { getImage, Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Lightbox from '../components/Lightbox.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const entries = (await getCollection('portfolio')).sort(
  (a, b) => (b.data.rok ?? 0) - (a.data.rok ?? 0) || a.data.title.localeCompare(b.data.title, 'cs'),
);
// a work links to its picture reduced to at most 2000 px, which the viewer (Lightbox) shows
const works = await Promise.all(
  entries.map(async (entry) => {
    const full = await getImage({ src: entry.data.obrazek, width: Math.min(entry.data.obrazek.width, 2000), format: 'webp' });
    return { ...entry, href: full.src, Content: (await render(entry)).Content };
  }),
);
const fields = [...new Set(works.map((work) => work.data.obor))].sort((a, b) => a.localeCompare(b, 'cs'));
const colors = ['var(--tomato)', 'var(--cobalt)', 'var(--pink)', 'var(--mint)', 'var(--sun)'];
const links = site.links.filter((link) => link.url);
---

<Base>
  <nav class="nav page" aria-label="Hlavní">
    <a class="logo" href="/" aria-label="Domů">{site.name.slice(0, 1)}.</a>
    <span class="nav-links">
      <a href="#portfolio">Portfolio</a>
      <a href="#o-mne">O mně</a>
    </span>
  </nav>

  <header class="hero page">
    <div class="shapes" aria-hidden="true">
      <span class="shape circle"></span>
      <span class="shape square"></span>
      <span class="shape star">✦</span>
      <span class="shape blob"></span>
    </div>
    <h1 aria-label={site.name}>
      {[...site.name].map((letter, i) => <span style={`--c: ${colors[i % colors.length]}; --i: ${i}`}>{letter}</span>)}
    </h1>
    {site.stickers.map((sticker, i) => <span class:list={['sticker', 'hand', `s${i}`]} aria-hidden="true">{sticker}</span>)}
    <p class="intro">{site.intro}</p>
    <a class="button" href="#portfolio">Mrkni na portfolio <span aria-hidden="true">→</span></a>
  </header>

  <div class="band-clip" aria-hidden="true">
    <div class="band">
      <div class="track">
        {[...site.topics, ...site.topics].map((topic) => <span>{topic} <i>✺</i></span>)}
      </div>
    </div>
  </div>

  <main>
    <section id="portfolio" class="page portfolio" aria-labelledby="portfolio-title">
      <div class="head">
        <h2 id="portfolio-title">Portfolio<sup>{works.length}</sup></h2>
        <div class="filters" role="group" aria-label="Filtr podle oboru">
          <button type="button" aria-pressed="true" data-filter="">vše</button>
          {fields.map((field) => <button type="button" aria-pressed="false" data-filter={field}>{field}</button>)}
        </div>
      </div>

      <ul class="grid">
        {works.map(({ data, href, Content }, i) => (
          <li class="work" data-obor={data.obor} style={`--tilt: ${((i % 5) - 2) * 0.6}deg`}>
            <a href={href} data-lightbox={data.title}>
              <Image src={data.obrazek} widths={[400, 800, 1200]} sizes="(min-width: 72rem) 24rem, (min-width: 40rem) 45vw, 100vw" alt={data.title} />
              {data.ukazka && <span class="sample hand">ukázka</span>}
            </a>
            <div class="caption">
              <h3>{data.title}</h3>
              <p class="meta">{[data.obor, data.technika, data.rok].filter(Boolean).join(' · ')}</p>
              <div class="note"><Content /></div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="o-mne" class="about" aria-labelledby="about-title">
      <div class="page about-inner">
        <h2 id="about-title" class="hand">ahoj, tady {site.name}</h2>
        <p class="about-text">{site.about}</p>
        <ul class="chips" aria-label="Co mě baví">
          {site.interests.map((interest, i) => <li style={`--tilt: ${((i % 3) - 1) * 2}deg`}>{interest}</li>)}
        </ul>
        {links.length > 0 && (
          <p class="about-links">{links.map((link) => <a href={link.url}>{link.title} ↗</a>)}</p>
        )}
      </div>
    </section>
  </main>

  <footer class="footer page">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="hand">vyrobeno s láskou a pastelkami</span>
  </footer>

  <Lightbox />
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const works = [...document.querySelectorAll<HTMLElement>('.work')];
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      for (const work of works) work.hidden = Boolean(filter) && work.dataset.obor !== filter;
    });
  }
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
    position: relative;
    z-index: 2;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 42% 58% 55% 45% / 50% 40% 60% 50%;
    background: var(--ink);
    color: var(--sun);
    font-weight: 800;
    font-size: 1.4rem;
    text-decoration: none;
    transition: transform 300ms;
  }
  .logo:hover {
    transform: rotate(-12deg) scale(1.05);
  }
  .nav-links {
    display: flex;
    gap: 0.5rem;
  }
  .nav-links a {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .nav-links a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(4rem, 9vw, 7rem);
  }
  h1 {
    position: relative;
    z-index: 1;
    font-size: clamp(6rem, 27vw, 20rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }
  h1 span {
    display: inline-block;
    color: var(--ink);
    transition: color 250ms, transform 250ms;
    animation: pop 700ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
    animation-delay: calc(var(--i) * 80ms);
  }
  h1 span:hover {
    color: var(--c);
    transform: translateY(-0.06em) rotate(-4deg);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(0.3em) scale(0.8);
    }
  }
  .sticker {
    position: absolute;
    z-index: 2;
    padding: 0.2rem 0.9rem;
    border-radius: 999px;
    font-size: clamp(1.3rem, 3vw, 2rem);
    box-shadow: 3px 3px 0 var(--ink);
    border: 2px solid var(--ink);
    animation: wobble 4s ease-in-out infinite;
  }
  .s0 {
    top: 12%;
    left: 52%;
    background: var(--pink);
    rotate: -8deg;
  }
  .s1 {
    top: 42%;
    right: 2%;
    background: var(--sun);
    rotate: 6deg;
    animation-delay: -1.5s;
  }
  .s2 {
    top: 6%;
    left: 4%;
    background: var(--mint);
    rotate: 4deg;
    animation-delay: -3s;
  }
  /* on a phone the notes sit above the name, so they cover neither the name nor the text */
  @media (max-width: 40rem) {
    .hero {
      padding-top: 4.5rem;
    }
    .sticker {
      font-size: 1.25rem;
    }
    .s0 {
      top: 0.75rem;
      left: auto;
      right: 0;
    }
    .s1 {
      display: none;
    }
    .s2 {
      top: 1rem;
      left: 0;
    }
  }
  @keyframes wobble {
    50% {
      transform: translateY(-6px) rotate(2deg);
    }
  }
  .shapes .shape {
    position: absolute;
    z-index: 0;
    animation: float 9s ease-in-out infinite;
  }
  .circle {
    width: clamp(6rem, 18vw, 14rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    top: 10%;
    right: 18%;
  }
  .square {
    width: clamp(3rem, 8vw, 6rem);
    aspect-ratio: 1;
    background: var(--cobalt);
    border-radius: 14px;
    bottom: 28%;
    left: 58%;
    rotate: 18deg;
    animation-delay: -3s;
  }
  .star {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--tomato);
    bottom: 12%;
    right: 6%;
    animation-delay: -5s;
  }
  .blob {
    width: clamp(5rem, 12vw, 9rem);
    aspect-ratio: 1;
    background: var(--pink);
    border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%;
    bottom: 4%;
    left: 30%;
    opacity: 0.8;
    animation-delay: -7s;
  }
  @keyframes float {
    50% {
      translate: 0 -14px;
      rotate: 8deg;
    }
  }
  .intro {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    margin-top: 2rem;
    font-size: clamp(1.15rem, 2.3vw, 1.4rem);
    line-height: 1.45;
  }
  .button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--tomato);
    transition: transform 200ms, box-shadow 200ms;
  }
  .button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--tomato);
  }

  /* the tilted band is wider than the page: its corners are cut here, so the page never scrolls sideways */
  .band-clip {
    overflow: hidden;
    padding-block: 1.5rem;
  }
  .band {
    overflow: hidden;
    background: var(--tomato);
    color: var(--paper);
    rotate: -2deg;
    margin-inline: -2rem;
    border-block: 3px solid var(--ink);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 30s linear infinite;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    text-transform: lowercase;
  }
  .track span {
    padding: 0.6rem 0 0.6rem 1.25rem;
    white-space: nowrap;
  }
  .track i {
    font-style: normal;
    color: var(--sun);
    margin-left: 1.25rem;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .portfolio {
    padding-block: clamp(5rem, 11vw, 8rem) clamp(3rem, 8vw, 5rem);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  h2 {
    font-size: clamp(3rem, 10vw, 6.5rem);
    font-weight: 800;
  }
  h2 sup {
    font-size: 0.3em;
    vertical-align: top;
    margin-left: 0.2em;
    color: var(--tomato);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters button {
    font: 600 1rem var(--sans);
    color: var(--ink);
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    cursor: pointer;
    transition: all 150ms;
  }
  .filters button:hover {
    background: var(--sun);
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 18rem;
    column-gap: 1.25rem;
  }
  .work {
    break-inside: avoid;
    margin-bottom: 1.75rem;
    rotate: var(--tilt);
    transition: rotate 300ms;
  }
  .work[hidden] {
    display: none;
  }
  .work:hover {
    rotate: 0deg;
  }
  .work a {
    position: relative;
    display: block;
    border: 3px solid var(--ink);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
    transition: transform 250ms, box-shadow 250ms;
  }
  .work a:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--ink);
  }
  .work :global(img) {
    width: 100%;
  }
  .sample {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    background: var(--paper);
    border: 2px solid var(--ink);
    font-size: 1.2rem;
    rotate: -4deg;
  }
  .caption {
    padding: 1rem 0.25rem 0;
  }
  .caption h3 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .meta {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .note {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .note :global(p:last-child) {
    margin-bottom: 0;
  }

  .about {
    background: var(--cobalt);
    color: var(--paper);
    padding-block: clamp(4rem, 10vw, 7rem);
    border-block: 3px solid var(--ink);
  }
  .about h2 {
    font-size: clamp(2.75rem, 8vw, 5rem);
    font-weight: 600;
    color: var(--sun);
    letter-spacing: 0;
  }
  .about-text {
    max-width: 44rem;
    margin-top: 1.5rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.35;
    font-weight: 500;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
  }
  .chips li {
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-weight: 600;
    rotate: var(--tilt);
    transition: rotate 200ms, background 200ms;
  }
  .chips li:nth-child(4n + 1):hover {
    background: var(--sun);
  }
  .chips li:nth-child(4n + 2):hover {
    background: var(--pink);
  }
  .chips li:nth-child(4n + 3):hover {
    background: var(--mint);
  }
  .chips li:nth-child(4n):hover {
    background: var(--tomato);
  }
  .chips li:hover {
    rotate: 0deg;
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .about-links a {
    padding: 0.5rem 1.1rem;
    border: 2px solid var(--paper);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .about-links a:hover {
    background: var(--paper);
    color: var(--cobalt);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem 3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .footer .hand {
    font-size: 1.4rem;
    color: var(--ink);
  }
</style>
