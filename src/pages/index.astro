---
import { getImage, Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Lightbox from '../components/Lightbox.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const entries = (await getCollection('portfolio')).sort(
  (a, b) => (b.data.rok ?? 0) - (a.data.rok ?? 0) || a.data.title.localeCompare(b.data.title, 'cs'),
);
// a work links to its picture reduced to at most 2000 px, which the viewer (Lightbox) shows
const works = await Promise.all(
  entries.map(async (entry) => {
    const full = await getImage({ src: entry.data.obrazek, width: Math.min(entry.data.obrazek.width, 2000), format: 'webp' });
    return { ...entry, href: full.src, Content: (await render(entry)).Content };
  }),
);
const featured = works[0];
const fields = [...new Set(works.map((work) => work.data.obor))].sort((a, b) => a.localeCompare(b, 'cs'));
const links = site.links.filter((link) => link.url);
---

<Base>
  <nav class="nav page" aria-label="Hlavní">
    <a class="brand" href="/">{site.name}</a>
    <span class="nav-links label">
      <a href="#portfolio">Portfolio</a>
      <a href="#o-mne">O mně</a>
    </span>
  </nav>

  <header class="hero page">
    <div class="hero-text">
      <p class="label">{site.label}</p>
      <h1>{site.name}<span class="dot">.</span></h1>
      <p class="intro">{site.intro}</p>
      <a class="more" href="#portfolio">Prohlédnout portfolio <span aria-hidden="true">→</span></a>
    </div>
    {featured && (
      <figure class="featured">
        <a href={featured.href} data-lightbox={featured.data.title}>
          <Image src={featured.data.obrazek} widths={[480, 960]} sizes="(min-width: 56rem) 26rem, 80vw" alt={featured.data.title} loading="eager" />
        </a>
        <figcaption class="label">{featured.data.title}{featured.data.rok && `, ${featured.data.rok}`}</figcaption>
      </figure>
    )}
  </header>

  <main>
    <section id="portfolio" class="page portfolio" aria-labelledby="portfolio-title">
      <div class="head">
        <h2 id="portfolio-title">Portfolio <span class="count">{works.length}</span></h2>
        <div class="filters label" role="group" aria-label="Filtr podle oboru">
          <button type="button" aria-pressed="true" data-filter="">Vše</button>
          {fields.map((field) => <button type="button" aria-pressed="false" data-filter={field}>{field}</button>)}
        </div>
      </div>

      <ul class="grid">
        {works.map(({ data, href, Content }) => (
          <li class="work" data-obor={data.obor}>
            <a href={href} data-lightbox={data.title}>
              <Image src={data.obrazek} widths={[400, 800, 1200]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 100vw" alt={data.title} />
              {data.ukazka && <span class="sample label">ukázka</span>}
            </a>
            <div class="caption">
              <h3>{data.title}</h3>
              <p class="label meta">{[data.obor, data.technika, data.rok].filter(Boolean).join(' · ')}</p>
              <div class="note"><Content /></div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="o-mne" class="about" aria-labelledby="about-title">
      <div class="page about-inner">
        <h2 id="about-title">O mně</h2>
        <div>
          <p class="about-text">{site.about}</p>
          <p class="label">Co mě baví</p>
          <ul class="interests">
            {site.interests.map((interest) => <li>{interest}</li>)}
          </ul>
          {links.length > 0 && (
            <p class="about-links label">{links.map((link) => <a href={link.url}>{link.title} ↗</a>)}</p>
          )}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer page label">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <a href="#top">Nahoru ↑</a>
  </footer>

  <Lightbox />
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const works = [...document.querySelectorAll<HTMLElement>('.work')];
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      for (const work of works) work.hidden = Boolean(filter) && work.dataset.obor !== filter;
    });
  }
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 1.75rem;
  }
  .brand {
    font: italic 400 1.5rem/1 var(--serif);
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--ink);
  }
  .nav-links a:hover {
    color: var(--rose);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(4rem, 9vw, 7rem);
  }
  h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(4.5rem, 14vw, 10.5rem);
    font-style: italic;
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.02em;
    line-height: 0.9;
    animation: fade 1.2s ease both;
  }
  .dot {
    color: var(--rose);
    font-style: normal;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(0.15em);
    }
  }
  .intro {
    max-width: 26rem;
    margin-top: 2rem;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .more {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--rose);
  }
  .featured {
    margin: 0;
    justify-self: end;
    width: min(100%, 26rem);
    animation: fade 1.4s 200ms ease both;
  }
  .featured a {
    display: block;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
    aspect-ratio: 4 / 5;
  }
  .featured :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s ease;
  }
  .featured a:hover :global(img) {
    transform: scale(1.04);
  }
  .featured figcaption {
    margin-top: 1rem;
    text-align: right;
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
    }
    .featured {
      justify-self: start;
      width: min(100%, 22rem);
    }
    .featured figcaption {
      text-align: left;
    }
  }

  .portfolio {
    padding-block: clamp(4rem, 9vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem 3rem;
    margin-bottom: 3rem;
  }
  h2 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    letter-spacing: -0.01em;
  }
  .count {
    font: 500 0.9rem var(--sans);
    color: var(--rose);
    vertical-align: super;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .filters button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: color 200ms, border-color 200ms;
  }
  .filters button:hover {
    color: var(--ink);
  }
  .filters button[aria-pressed='true'] {
    color: var(--ink);
    border-bottom-color: var(--rose);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 17rem;
    column-gap: 2rem;
  }
  .work {
    break-inside: avoid;
    margin-bottom: 2.75rem;
  }
  .work[hidden] {
    display: none;
  }
  .work a {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--paper-2);
  }
  .work :global(img) {
    width: 100%;
    transition: transform 900ms ease, opacity 300ms;
  }
  .work a:hover :global(img) {
    transform: scale(1.03);
  }
  .sample {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.3rem 0.6rem;
    background: rgb(246 241 234 / 0.9);
    color: var(--ink);
    font-size: 0.62rem;
  }
  .caption {
    padding-top: 1rem;
  }
  .caption h3 {
    font-size: 1.5rem;
    font-variation-settings: 'opsz' 28;
  }
  .meta {
    margin: 0.5rem 0 0;
    font-size: 0.66rem;
  }
  .note {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .note :global(p:last-child) {
    margin-bottom: 0;
  }

  .about {
    background: var(--paper-2);
    padding-block: clamp(4rem, 10vw, 7rem);
  }
  .about-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 2rem 4rem;
  }
  .about h2 {
    font-style: italic;
  }
  .about-text {
    font: 400 clamp(1.4rem, 2.8vw, 2rem)/1.4 var(--serif);
    font-variation-settings: 'opsz' 36;
    margin-bottom: 2.5rem;
  }
  .interests {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
  }
  .interests li {
    padding: 0.4rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.92rem;
    transition: border-color 200ms, color 200ms;
  }
  .interests li:hover {
    border-color: var(--rose);
    color: var(--rose);
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 2.5rem;
  }
  @media (max-width: 48rem) {
    .about-inner {
      grid-template-columns: 1fr;
    }
  }

  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 3rem;
  }
  .footer a {
    text-decoration: none;
  }
</style>
